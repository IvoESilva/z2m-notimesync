{
  "name": "Zigbee2MQTT No Time Sync",
  "version": "1.0.0",
  "slug": "zigbee2mqtt_nosync",
  "description": "Zigbee2MQTT with Tuya time-sync disabled",
  "arch": ["aarch64"],
  "startup": "services",
  "boot": "auto",
  "ports": {
    "8080/tcp": 8080
  },
  "host_network": true,
  "map": ["config:rw", "share:rw"],
  "privileged": ["SYS_ADMIN"],
  "options": {
    "data_path": "/config/zigbee2mqtt",
    "mqtt": {
      "server": "mqtt://homeassistant",
      "user": "",
      "password": ""
    },
    "serial": {
      "port": "auto",
      "adapter": "auto"
    },
    "advanced": {
      "log_level": "info",
      "pan_id": 6754,
      "channel": 11,
      "network_key": [
        1, 3, 5, 7, 9, 11, 13, 15,
        0, 2, 4, 6, 8, 10, 12, 13
      ],
      "availability_blocklist": [],
      "availability_passlist": []
    },
    "frontend": {
      "port": 8080
    },
    "devices": "devices.yaml",
    "groups": "groups.yaml"
  },
  "schema": {
    "data_path": "str",
    "mqtt": {
      "server": "str",
      "user": "str?",
      "password": "str?"
    },
    "serial": {
      "port": "str",
      "adapter": "str"
    },
    "advanced": {
      "log_level": "str",
      "pan_id": "int",
      "channel": "int",
      "network_key": ["int"],
      "availability_blocklist": ["str"],
      "availability_passlist": ["str"]
    },
    "frontend": {
      "port": "int"
    },
    "devices": "str",
    "groups": "str"
  }
}
